{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/tome-trpg/tome/main/schemas/tome-lang-1.schema.json",
  "title": "tome-lang/1",
  "description": "A language profile. What a language needs is data, so the engine core never branches on a language code.",
  "type": "object",
  "required": ["schema", "kind"],
  "properties": {
    "schema": { "const": "tome-lang/1" },
    "kind": { "enum": ["source", "target"] }
  },
  "if": {
    "type": "object",
    "properties": { "kind": { "const": "source" } }
  },
  "then": { "$ref": "#/$defs/source" },
  "else": { "$ref": "#/$defs/target" },
  "$defs": {
    "lang": {
      "description": "BCP 47 language tag.",
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "ratio": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
    "byteRanges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": { "type": "integer", "minimum": 0, "maximum": 255 }
      }
    },
    "replacements": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "marks": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "nextStarts": {
      "description": "What the next line must start with for the rule to apply.",
      "enum": ["lower", "any"]
    },
    "source": {
      "type": "object",
      "required": [
        "schema",
        "kind",
        "lang",
        "name",
        "writing_mode",
        "normalize",
        "dehyphenate",
        "join",
        "text_quality"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "tome-lang/1" },
        "kind": { "const": "source" },
        "lang": { "$ref": "#/$defs/lang" },
        "name": { "type": "string", "minLength": 1 },
        "writing_mode": { "enum": ["horizontal-tb", "vertical-rl"] },
        "normalize": {
          "type": "object",
          "required": ["form", "replace"],
          "additionalProperties": false,
          "properties": {
            "form": { "enum": ["NFC", "NFKC"] },
            "replace": { "$ref": "#/$defs/replacements" }
          }
        },
        "dehyphenate": {
          "description": "Undoing a word broken at a line end.",
          "type": "object",
          "required": ["hyphens", "next_starts"],
          "additionalProperties": false,
          "properties": {
            "hyphens": { "$ref": "#/$defs/marks" },
            "next_starts": { "$ref": "#/$defs/nextStarts" }
          }
        },
        "join": {
          "description": "Joining a paragraph split across a column or a page.",
          "type": "object",
          "required": ["sentence_end", "next_starts"],
          "additionalProperties": false,
          "properties": {
            "sentence_end": { "$ref": "#/$defs/marks" },
            "next_starts": { "$ref": "#/$defs/nextStarts" }
          }
        },
        "text_quality": {
          "description": "How a page of this language should look. Used to catch a text layer whose characters are legal but wrong.",
          "type": "object",
          "required": ["letter_frequency", "min_letters", "min_similarity"],
          "additionalProperties": false,
          "properties": {
            "letter_frequency": {
              "type": "object",
              "minProperties": 2,
              "propertyNames": { "minLength": 1, "maxLength": 1 },
              "additionalProperties": { "type": "number", "exclusiveMinimum": 0 }
            },
            "min_letters": { "type": "integer", "minimum": 1 },
            "min_similarity": { "$ref": "#/$defs/ratio" }
          }
        }
      }
    },
    "target": {
      "type": "object",
      "required": [
        "schema",
        "kind",
        "lang",
        "name",
        "punctuation",
        "pronouns",
        "min_length_ratio",
        "max_length_ratio",
        "style_guide",
        "script_check",
        "term_checks",
        "term_exceptions"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "tome-lang/1" },
        "kind": { "const": "target" },
        "lang": { "$ref": "#/$defs/lang" },
        "name": { "type": "string", "minLength": 1 },
        "punctuation": {
          "description": "Fixed after translation without spending tokens.",
          "type": "object",
          "required": ["replace", "quotes", "space_around_latin"],
          "additionalProperties": false,
          "properties": {
            "replace": { "$ref": "#/$defs/replacements" },
            "quotes": {
              "type": "object",
              "required": ["open", "close", "inner_open", "inner_close"],
              "additionalProperties": false,
              "properties": {
                "open": { "type": "string", "minLength": 1 },
                "close": { "type": "string", "minLength": 1 },
                "inner_open": { "type": "string", "minLength": 1 },
                "inner_close": { "type": "string", "minLength": 1 }
              }
            },
            "space_around_latin": { "type": "boolean" }
          }
        },
        "pronouns": {
          "description": "The set a default pronoun of an entity class is chosen from.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "min_length_ratio": {
          "description": "A translation shorter than this share of the source looks like a summary.",
          "$ref": "#/$defs/ratio"
        },
        "max_length_ratio": {
          "description": "A translation longer than this share of the source is reported, never resent.",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "style_guide": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "script_check": {
          "description": "Characters of another script. Finding one sends the unit again, so a false alarm costs money. The characters of a legacy encoding are the ones allowed.",
          "type": "object",
          "required": [
            "encoding",
            "lead_ranges",
            "trail_ranges",
            "shared_forms",
            "allowed_words",
            "misused_words"
          ],
          "additionalProperties": false,
          "properties": {
            "encoding": {
              "description": "A TextDecoder label.",
              "type": "string",
              "minLength": 1
            },
            "lead_ranges": { "$ref": "#/$defs/byteRanges" },
            "trail_ranges": { "$ref": "#/$defs/byteRanges" },
            "shared_forms": {
              "description": "Characters of the other script that the encoding holds too.",
              "type": "string"
            },
            "allowed_words": {
              "description": "Words where a shared form is correct.",
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "misused_words": {
              "description": "Words that are wrong though each character is fine.",
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "opencc": {
          "description": "The OpenCC phrase table for the wording check, which only reports: the phrases that `to` adds on top of `from`.",
          "type": "object",
          "required": ["from", "to"],
          "additionalProperties": false,
          "properties": {
            "from": { "type": "string", "minLength": 1 },
            "to": { "type": "string", "minLength": 1 }
          }
        },
        "term_checks": {
          "description": "Wording to report, never to resend.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["avoid", "prefer"],
            "additionalProperties": false,
            "properties": {
              "avoid": { "type": "string", "minLength": 1 },
              "prefer": { "type": "string", "minLength": 1 }
            }
          }
        },
        "term_exceptions": {
          "description": "Words the wording check must not report.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
