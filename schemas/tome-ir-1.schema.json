{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/tome-trpg/tome/main/schemas/tome-ir-1.schema.json",
  "title": "tome-ir/1",
  "description": "TOME document IR. One JSON file is either a source page written by a parsing engine or the assembled document layer. The overrides layer is a separate YAML file and is not described here.",
  "type": "object",
  "required": ["schema", "layer"],
  "properties": {
    "schema": { "const": "tome-ir/1" },
    "layer": { "enum": ["source", "document"] }
  },
  "if": {
    "type": "object",
    "properties": { "layer": { "const": "source" } }
  },
  "then": { "$ref": "#/$defs/sourcePage" },
  "else": { "$ref": "#/$defs/document" },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "blockId": {
      "description": "Physical start page, content hash prefix, and a sequence number when the same text repeats on a page.",
      "type": "string",
      "pattern": "^p[0-9]{4,}-[0-9a-f]{6}(-[0-9]+)?$"
    },
    "pageIndex": {
      "description": "Physical page index, starting at zero. Printed page numbers live in page_map.",
      "type": "integer",
      "minimum": 0
    },
    "lang": {
      "description": "BCP 47 language tag.",
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "coreRole": {
      "enum": [
        "title",
        "heading",
        "paragraph",
        "list_item",
        "table",
        "sidebar",
        "figure",
        "caption",
        "footnote",
        "toc",
        "index",
        "credits",
        "furniture"
      ]
    },
    "packRole": {
      "description": "A role declared by a rule pack, written <pack id>:<role>. The engine core passes it through without reading it.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*:[a-z0-9]+([_-][a-z0-9]+)*$"
    },
    "span": {
      "type": "object",
      "required": ["page", "bbox"],
      "additionalProperties": false,
      "properties": {
        "page": { "$ref": "#/$defs/pageIndex" },
        "bbox": {
          "description": "x0, y0, x1, y1 in PDF points.",
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "number" }
        }
      }
    },
    "run": {
      "description": "Inline marks over text, as UTF-16 offsets into the block text.",
      "type": "object",
      "required": ["start", "end"],
      "additionalProperties": false,
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 },
        "marks": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["bold", "italic", "small_caps"] }
        },
        "ruby": { "type": "string", "minLength": 1 },
        "link": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "page": { "$ref": "#/$defs/pageIndex" },
            "uri": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "runs": {
      "type": "array",
      "items": { "$ref": "#/$defs/run" }
    },
    "cell": {
      "description": "One table cell, which is one translation unit.",
      "type": "object",
      "required": ["row", "col", "text"],
      "additionalProperties": false,
      "properties": {
        "row": { "type": "integer", "minimum": 0 },
        "col": { "type": "integer", "minimum": 0 },
        "row_span": { "type": "integer", "minimum": 1 },
        "col_span": { "type": "integer", "minimum": 1 },
        "header": { "type": "boolean" },
        "text": { "type": "string" },
        "raw": { "type": "string" },
        "runs": { "$ref": "#/$defs/runs" }
      }
    },
    "table": {
      "type": "object",
      "required": ["rows", "cols", "cells"],
      "additionalProperties": false,
      "properties": {
        "rows": { "type": "integer", "minimum": 1 },
        "cols": { "type": "integer", "minimum": 1 },
        "cells": {
          "type": "array",
          "items": { "$ref": "#/$defs/cell" }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["engine", "version", "config_hash"],
      "additionalProperties": false,
      "properties": {
        "engine": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "config_hash": { "$ref": "#/$defs/sha256" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "block": {
      "type": "object",
      "required": [
        "id",
        "content_hash",
        "role",
        "spans",
        "text",
        "raw",
        "lang",
        "writing_mode",
        "provenance"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/blockId" },
        "content_hash": { "$ref": "#/$defs/sha256" },
        "role": true,
        "flow": { "enum": ["main", "aside"] },
        "group": { "type": "string", "minLength": 1 },
        "section": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "spans": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/span" }
        },
        "text": { "type": "string" },
        "raw": { "type": "string" },
        "runs": { "$ref": "#/$defs/runs" },
        "table": { "$ref": "#/$defs/table" },
        "lang": { "$ref": "#/$defs/lang" },
        "writing_mode": { "enum": ["horizontal-tb", "vertical-rl"] },
        "provenance": { "$ref": "#/$defs/provenance" }
      },
      "if": {
        "type": "object",
        "required": ["role"],
        "properties": { "role": { "const": "table" } }
      },
      "then": { "type": "object", "required": ["table"] }
    },
    "sourceBlock": {
      "description": "Engines fill core roles only. Pack roles are decided at assembly.",
      "type": "object",
      "$ref": "#/$defs/block",
      "properties": { "role": { "$ref": "#/$defs/coreRole" } },
      "unevaluatedProperties": false
    },
    "documentBlock": {
      "type": "object",
      "$ref": "#/$defs/block",
      "required": ["flow"],
      "properties": {
        "role": {
          "anyOf": [{ "$ref": "#/$defs/coreRole" }, { "$ref": "#/$defs/packRole" }]
        }
      },
      "unevaluatedProperties": false
    },
    "pageLabel": {
      "description": "Maps a physical page index to the printed page number, which may be a roman numeral.",
      "type": "object",
      "required": ["page", "label"],
      "additionalProperties": false,
      "properties": {
        "page": { "$ref": "#/$defs/pageIndex" },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "section": {
      "type": "object",
      "required": ["title", "children"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "block_id": { "$ref": "#/$defs/blockId" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/section" }
        }
      }
    },
    "sourcePage": {
      "type": "object",
      "required": ["schema", "layer", "pdf_sha256", "page", "blocks"],
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "tome-ir/1" },
        "layer": { "const": "source" },
        "pdf_sha256": { "$ref": "#/$defs/sha256" },
        "page": { "$ref": "#/$defs/pageIndex" },
        "blocks": {
          "type": "array",
          "items": { "$ref": "#/$defs/sourceBlock" }
        }
      }
    },
    "document": {
      "type": "object",
      "required": ["schema", "layer", "pdf_sha256", "page_map", "sections", "blocks"],
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "tome-ir/1" },
        "layer": { "const": "document" },
        "pdf_sha256": { "$ref": "#/$defs/sha256" },
        "page_map": {
          "type": "array",
          "items": { "$ref": "#/$defs/pageLabel" }
        },
        "sections": {
          "type": "array",
          "items": { "$ref": "#/$defs/section" }
        },
        "blocks": {
          "description": "In reading order. The order lives here, never in the block id.",
          "type": "array",
          "items": { "$ref": "#/$defs/documentBlock" }
        }
      }
    }
  }
}
