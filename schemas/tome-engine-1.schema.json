{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/tome-trpg/tome/main/schemas/tome-engine-1.schema.json",
  "title": "tome-engine/1",
  "description": "The protocol between TOME and a parsing engine. The root describes engine.yaml, and $defs describes the manifest, the progress events on stdout, the run record engine.json and TOME's own install record. The pages an engine writes are tome-ir/1.",
  "$ref": "#/$defs/spec",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "version": {
      "description": "The version an engine reports. It becomes a folder name, so it stays plain.",
      "type": "string",
      "pattern": "^[0-9A-Za-z][0-9A-Za-z._+-]*$",
      "maxLength": 64
    },
    "pageIndex": {
      "description": "Physical page index, starting at zero.",
      "type": "integer",
      "minimum": 0
    },
    "pageKind": {
      "enum": ["native", "scan", "broken_text", "image_only"]
    },
    "device": {
      "enum": ["cpu", "gpu"]
    },
    "reason": {
      "description": "A short code, never a message: a message can carry book text.",
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "maxLength": 64
    },
    "license": {
      "description": "Code and weights are reviewed apart, because they often differ (LC-3).",
      "type": "object",
      "required": ["code", "weights"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "weights": { "type": "string", "minLength": 1 }
      }
    },
    "spec": {
      "type": "object",
      "required": ["schema", "name", "pages", "command", "license", "setup"],
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "tome-engine/1" },
        "name": { "$ref": "#/$defs/name" },
        "pages": {
          "description": "The page kinds this engine can handle.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/pageKind" }
        },
        "command": {
          "description": "How to start the engine, relative to its folder. With setup kind uv, a first word of python means the Python in its environment.",
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "license": { "$ref": "#/$defs/license" },
        "setup": {
          "description": "How the environment is built. Only uv and none exist: an engine.yaml cannot name install commands of its own.",
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["uv", "none"] },
            "extras": {
              "description": "The uv extra for each device.",
              "type": "object",
              "required": ["cpu"],
              "additionalProperties": false,
              "properties": {
                "cpu": { "type": "string", "minLength": 1 },
                "gpu": { "type": "string", "minLength": 1 }
              }
            },
            "prepare": {
              "description": "True when the engine has to fetch weights at install time, with --prepare --data <dir>. It is the only time an engine may reach the network.",
              "type": "boolean"
            }
          }
        },
        "env": {
          "description": "Set for every run, after the keys are filtered out. This is where an engine declares that it stays offline.",
          "type": "object",
          "propertyNames": { "pattern": "^[A-Z][A-Z0-9_]*$" },
          "additionalProperties": { "type": "string" }
        },
        "gpu": {
          "type": "object",
          "required": ["min_vram_mb"],
          "additionalProperties": false,
          "properties": {
            "min_vram_mb": {
              "description": "With less free VRAM than this the engine runs on the CPU.",
              "type": "integer",
              "minimum": 1
            },
            "download_mb": {
              "description": "How much more the GPU build downloads, shown before anyone picks it.",
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "manifest": {
      "description": "What TOME hands the engine as <command> --manifest <path>.",
      "type": "object",
      "required": [
        "schema",
        "pdf",
        "pdf_sha256",
        "pages",
        "output_dir",
        "data_dir",
        "source_lang",
        "config_hash",
        "options"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "tome-engine/1" },
        "pdf": { "type": "string", "minLength": 1 },
        "pdf_sha256": { "$ref": "#/$defs/sha256" },
        "pages": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/pageIndex" }
        },
        "output_dir": { "type": "string", "minLength": 1 },
        "data_dir": { "type": "string", "minLength": 1 },
        "source_lang": { "type": "string", "minLength": 1 },
        "config_hash": { "$ref": "#/$defs/sha256" },
        "options": {
          "type": "object",
          "required": ["device"],
          "additionalProperties": false,
          "properties": {
            "device": { "$ref": "#/$defs/device" }
          }
        }
      }
    },
    "pageResult": {
      "type": "object",
      "required": ["page", "status"],
      "additionalProperties": false,
      "properties": {
        "page": { "$ref": "#/$defs/pageIndex" },
        "status": { "enum": ["ok", "failed"] },
        "reason": { "$ref": "#/$defs/reason" }
      }
    },
    "event": {
      "description": "One line of JSON on stdout. Events only report progress: the files are what counts.",
      "oneOf": [
        {
          "type": "object",
          "required": ["event", "page", "status"],
          "additionalProperties": false,
          "properties": {
            "event": { "const": "page" },
            "page": { "$ref": "#/$defs/pageIndex" },
            "status": { "enum": ["ok", "failed"] },
            "reason": { "$ref": "#/$defs/reason" }
          }
        },
        {
          "type": "object",
          "required": ["event"],
          "additionalProperties": false,
          "properties": {
            "event": { "const": "done" }
          }
        }
      ]
    },
    "run": {
      "description": "engine.json, written by the engine at the end of a run (LC-3).",
      "type": "object",
      "required": ["schema", "name", "version", "license", "config_hash", "pages"],
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "tome-engine/1" },
        "name": { "$ref": "#/$defs/name" },
        "version": { "$ref": "#/$defs/version" },
        "license": { "$ref": "#/$defs/license" },
        "config_hash": { "$ref": "#/$defs/sha256" },
        "pages": {
          "type": "array",
          "items": { "$ref": "#/$defs/pageResult" }
        }
      }
    },
    "install": {
      "description": "TOME's own record of an installed engine, kept in its folder.",
      "type": "object",
      "required": ["schema", "name", "version", "device", "tree_hash", "origin"],
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "tome-engine/1" },
        "name": { "$ref": "#/$defs/name" },
        "version": { "$ref": "#/$defs/version" },
        "device": { "$ref": "#/$defs/device" },
        "tree_hash": { "$ref": "#/$defs/sha256" },
        "origin": { "enum": ["bundled", "path"] }
      }
    }
  }
}
