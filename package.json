{
  "name": "tome-trpg",
  "version": "0.0.0",
  "private": true,
  "description": "TRPG Omnilingual Markdown Engine: translate TRPG books you own into Traditional Chinese.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tome-trpg/tome.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "tome": "dist/cli/main.js",
    "tome-trpg": "dist/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./schemas/*": "./schemas/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "engines",
    "languages",
    "schemas"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "licenses": "node tools/check-licenses.ts",
    "spec": "npm run spec:guard && npm run spec:prove && npm run spec:cites && npm run spec:graph && npm run spec:briefs && npm run spec:matrix && npm run spec:schedule && npm run spec:premises",
    "spec:guard": "spec-guard",
    "spec:prove": "spec-guard prove",
    "spec:cites": "spec-guard cites --strict",
    "spec:graph": "spec-graph check",
    "spec:briefs": "spec-brief lint",
    "spec:matrix": "spec-brief matrix",
    "spec:schedule": "spec-brief schedule",
    "spec:premises": "spec-harness premises",
    "spec:doctor": "spec-harness doctor"
  },
  "dependencies": {
    "@napi-rs/keyring": "2.1.2",
    "ajv": "8.20.0",
    "unpdf": "1.9.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@spec-family/spec-brief": "0.12.0",
    "@spec-family/spec-graph": "0.21.0",
    "@spec-family/spec-guard": "0.30.0",
    "@spec-family/spec-harness": "0.22.0",
    "@types/node": "26.6.4",
    "@types/pdfkit": "0.17.7",
    "fast-check": "4.10.2",
    "pdfkit": "0.20.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
